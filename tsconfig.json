{
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": "./",
		"esModuleInterop": true,
		"module": "es2020",
		"moduleResolution": "node",
		"outDir": "Target",
		"paths": {
			"types": [
				"src/types"
			]
		},
		"resolveJsonModule": true,
		"rootDir": "src",
		"strict": true,
		"target": "es5"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"api-src",
		"src"
	]
}
